# Application Configuration
# Copy this file to .env.local for local development
# DO NOT commit .env.local to version control

# =============================================================================
# SITE CONFIGURATION
# =============================================================================

# The base URL of your website (used for sitemap, SEO, etc.)
# In production, this should be your actual domain
NEXT_PUBLIC_SITE_URL=https://gabrieltjaeger.github.io

# Site name (used in metadata and structured data)
NEXT_PUBLIC_SITE_NAME=Gabriel Trugillo Jaeger

# Default site title (used as fallback metadata)
NEXT_PUBLIC_SITE_TITLE=Gabriel Jaeger | Software Architect

# Default site description
NEXT_PUBLIC_SITE_DESCRIPTION=Portfolio showcasing software architecture, clean code, and scalable systems engineered by Gabriel Trugillo Jaeger.

# Optional comma-separated keywords for SEO (e.g. "software architecture, clean code")
NEXT_PUBLIC_SITE_KEYWORDS=software architecture,clean code,domain-driven design,portfolio

# Optional path or URL to the default Open Graph image
# Can be relative (served from public/) or absolute
NEXT_PUBLIC_OG_IMAGE=/placeholder.jpg

# Primary contact email used in structured data
NEXT_PUBLIC_CONTACT_EMAIL=hello@gabrieltjaeger.com.br

# Optional per-locale domains (uncomment if you use different domains per language)
# NEXT_PUBLIC_SITE_URL_EN=https://en.example.com
# NEXT_PUBLIC_SITE_URL_PT=https://pt.example.com

# Social profiles (optional, improves structured data)
NEXT_PUBLIC_SOCIAL_GITHUB=https://github.com/gabrieltjaeger
NEXT_PUBLIC_SOCIAL_LINKEDIN=https://linkedin.com/in/gabrieltjaeger
# NEXT_PUBLIC_SOCIAL_TWITTER=https://twitter.com/your-handle
# NEXT_PUBLIC_SOCIAL_YOUTUBE=https://youtube.com/@your-channel
# NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://instagram.com/your-profile

# Default locale for the application (en, pt)
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Available locales (comma-separated)
NEXT_PUBLIC_AVAILABLE_LOCALES=en,pt

# =============================================================================
# THEME CONFIGURATION
# =============================================================================

# Default theme mode: 'light', 'dark', or 'system'
NEXT_PUBLIC_DEFAULT_THEME=system

# LocalStorage key for theme persistence
NEXT_PUBLIC_THEME_STORAGE_KEY=theme

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# Development server port
PORT=3000

# Enable debug mode (shows theme debug panel)
NEXT_PUBLIC_DEBUG_MODE=false

# =============================================================================
# TEST CONFIGURATION
# =============================================================================

# Playwright test base URL
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000

# Cypress test base URL
CYPRESS_BASE_URL=http://localhost:3000

# =============================================================================
# ANALYTICS & MONITORING
# =============================================================================

# Vercel Analytics (automatically injected by Vercel)
# VERCEL_ANALYTICS_ID=

# Google Analytics tracking ID (if using)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# =============================================================================
# API CONFIGURATION
# =============================================================================

# If you have external APIs in the future, add them here
# NEXT_PUBLIC_API_BASE_URL=
# API_SECRET_KEY=

# =============================================================================
# BUILD CONFIGURATION
# =============================================================================

# CI environment flag
# CI=true

# Node environment
# NODE_ENV=development
